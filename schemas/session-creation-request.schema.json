{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp-session-gateway.local/schemas/session-creation-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clientOperationId",
    "revision",
    "projectId",
    "workingCopyId",
    "profileId"
  ],
  "properties": {
    "clientOperationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "workingCopyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    }
  }
}
