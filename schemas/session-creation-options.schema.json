{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp-session-gateway.local/schemas/session-creation-options.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "available",
    "projects",
    "profiles"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "available": {
      "type": "boolean"
    },
    "reason": {
      "enum": [
        "not_configured",
        "tern_unavailable",
        "configuration_unavailable",
        "ledger_unavailable"
      ]
    },
    "projects": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "workingCopies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "workingCopies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "available": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "projects": {
            "maxItems": 0
          },
          "profiles": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "reason"
          ]
        },
        "properties": {
          "projects": {
            "minItems": 1
          },
          "profiles": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
