{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omp-session-gateway/session-list.schema.json",
  "title": "OMP Session Gateway metadata-only session list",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "sessions"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sessions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "generation",
          "startedAt",
          "lastSeenAt",
          "canView",
          "canControl",
          "inputRequired"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^[a-z0-9-]{8,64}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "qualificationPushAlias": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "cwdLabel": {
            "type": "string",
            "maxLength": 256
          },
          "model": {
            "type": "string",
            "maxLength": 256
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          },
          "canView": {
            "type": "boolean"
          },
          "canControl": {
            "type": "boolean"
          },
          "inputRequired": {
            "type": "boolean"
          },
          "busy": {
            "type": "boolean"
          },
          "ask": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requestId", "since"],
            "properties": {
              "requestId": {
                "type": "string",
                "minLength": 16,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]{16,128}$"
              },
              "since": {
                "type": "string",
                "format": "date-time",
                "maxLength": 64
              },
              "preview": {
                "type": "string",
                "maxLength": 256
              },
              "optionCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              }
            }
          }
        },
        "if": { "properties": { "inputRequired": { "const": true } } },
        "then": { "properties": { "ask": true }, "required": ["ask"] },
        "else": { "properties": { "ask": false, "qualificationPushAlias": false } }
      }
    }
  }
}
