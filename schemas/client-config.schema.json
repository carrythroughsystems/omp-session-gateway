{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omp-session-gateway/client-config.schema.json",
  "title": "OMP Session Gateway public client configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "local",
    "targets",
    "speech"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "local": {
      "$ref": "#/$defs/source"
    },
    "targets": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browserRecognition"
      ],
      "properties": {
        "browserRecognition": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 256,
          "pattern": "^(?!https://.*:443$)(?!http://.*:80$)(?:https://(?:[a-z0-9.!\"$&'()*+,;=_~`{}-]+|\\[[0-9a-f:]+\\])|http://(?:127\\.0\\.0\\.1|\\[::1\\]))(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
          "$comment": "The parser enforces exact URL.origin spelling, HTTPS or loopback HTTP, and target origins differing from http.publicOrigin."
        }
      }
    }
  }
}
