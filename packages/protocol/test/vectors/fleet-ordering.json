{
  "comment": "Fleet worker ordering vectors (ADR-048). Shared by protocol, service-worker, and harness tests. A step is a v3 push (`push`), a v2 push (`legacy`), a page reconciliation (`reconcile`), a worker restart that keeps only persisted state (`restart`), or a clock advance in milliseconds (`advance`). `expect.displayed` lists `tag|kind|requestId-or-generation` after the last step; `expect.badge` is the last applied badge; `expect.alerts` counts shows that alert (`renotify` or a new tag).",
  "defaults": {
    "studio": "xeffoL_kxqTcht3AiIR0FT",
    "laptop": "Zm7JF6omGejLZ9M1ygWBi2"
  },
  "scenarios": [
    {
      "name": "same instance on two hosts keeps separate alerts and clears",
      "steps": [
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_studio_000000a",
            "seq": [
              1,
              1
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "laptop",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_laptop_000000a",
            "seq": [
              1,
              2
            ],
            "badge": [
              2,
              true
            ]
          }
        },
        {
          "push": {
            "type": "clear",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_studio_000000a",
            "seq": [
              1,
              3
            ],
            "badge": [
              1,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-Zm7JF6omGejLZ9M1ygWBi2-aaaa1111bbbb2222|attention|req_laptop_000000a"
        ],
        "badge": [
          1,
          true
        ],
        "alerts": 2
      }
    },
    {
      "name": "two simultaneous asks on different sessions both stay actionable",
      "steps": [
        {
          "push": {
            "type": "attention",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_local_0000000a",
            "seq": [
              1,
              1
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "cccc3333dddd4444",
            "requestId": "req_studio_000000b",
            "seq": [
              1,
              2
            ],
            "badge": [
              2,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-aaaa1111bbbb2222|attention|req_local_0000000a",
          "omp-attention-xeffoL_kxqTcht3AiIR0FT-cccc3333dddd4444|attention|req_studio_000000b"
        ],
        "badge": [
          2,
          true
        ],
        "alerts": 2
      }
    },
    {
      "name": "a late clear for request A never closes the newer request B or lowers its badge",
      "steps": [
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_request_00000a",
            "seq": [
              1,
              1
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_request_00000b",
            "seq": [
              1,
              3
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "push": {
            "type": "clear",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_request_00000a",
            "seq": [
              1,
              2
            ],
            "badge": [
              0,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-xeffoL_kxqTcht3AiIR0FT-aaaa1111bbbb2222|attention|req_request_00000b"
        ],
        "badge": [
          1,
          true
        ],
        "alerts": 2
      }
    },
    {
      "name": "a clear that overtakes its attention keeps it suppressed across a worker restart",
      "steps": [
        {
          "push": {
            "type": "clear",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_overtaken_000a",
            "seq": [
              1,
              2
            ],
            "badge": [
              0,
              true
            ]
          }
        },
        {
          "restart": true
        },
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_overtaken_000a",
            "seq": [
              1,
              1
            ],
            "badge": [
              1,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [],
        "badge": [
          0,
          true
        ],
        "alerts": 0
      }
    },
    {
      "name": "duplicates do not alert twice and older counts never overwrite newer ones",
      "steps": [
        {
          "push": {
            "type": "attention",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_duplicate_000a",
            "seq": [
              1,
              2
            ],
            "badge": [
              2,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_duplicate_000a",
            "seq": [
              1,
              2
            ],
            "badge": [
              2,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "instanceId": "cccc3333dddd4444",
            "requestId": "req_duplicate_000b",
            "seq": [
              1,
              1
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "push": {
            "type": "clear",
            "instanceId": "eeee5555ffff6666",
            "requestId": "req_duplicate_000c",
            "seq": [
              1,
              3
            ],
            "badge": [
              2,
              true
            ]
          }
        },
        {
          "push": {
            "type": "clear",
            "instanceId": "eeee5555ffff6666",
            "requestId": "req_duplicate_000c",
            "seq": [
              1,
              3
            ],
            "badge": [
              2,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-aaaa1111bbbb2222|attention|req_duplicate_000a",
          "omp-attention-cccc3333dddd4444|attention|req_duplicate_000b"
        ],
        "badge": [
          2,
          true
        ],
        "alerts": 2
      }
    },
    {
      "name": "a coordinator restart drops old-epoch messages, replays without re-alerting, and syncs away resolved asks",
      "steps": [
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_epoch_00000000a",
            "seq": [
              7,
              4
            ],
            "badge": [
              2,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "cccc3333dddd4444",
            "requestId": "req_epoch_00000000b",
            "seq": [
              7,
              5
            ],
            "badge": [
              2,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_epoch_00000000a",
            "seq": [
              8,
              1
            ],
            "badge": [
              1,
              false
            ]
          }
        },
        {
          "push": {
            "type": "sync",
            "seq": [
              8,
              2
            ],
            "badge": [
              1,
              true
            ],
            "fresh": [
              "local",
              "studio"
            ],
            "pending": [
              {
                "source": "studio",
                "instanceId": "aaaa1111bbbb2222",
                "generation": 1,
                "requestId": "req_epoch_00000000a"
              }
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "cccc3333dddd4444",
            "requestId": "req_epoch_00000000b",
            "seq": [
              7,
              6
            ],
            "badge": [
              9,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-xeffoL_kxqTcht3AiIR0FT-aaaa1111bbbb2222|attention|req_epoch_00000000a"
        ],
        "badge": [
          1,
          true
        ],
        "alerts": 2
      }
    },
    {
      "name": "a stop is shown, an ask replaces it with a fresh alert, and an older stop cannot return",
      "steps": [
        {
          "push": {
            "type": "activity_stop",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "seq": [
              1,
              1
            ],
            "badge": [
              0,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_stop_000000000a",
            "seq": [
              1,
              3
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "push": {
            "type": "activity_stop",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "seq": [
              1,
              2
            ],
            "badge": [
              0,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-xeffoL_kxqTcht3AiIR0FT-aaaa1111bbbb2222|attention|req_stop_000000000a"
        ],
        "badge": [
          1,
          true
        ],
        "alerts": 2
      }
    },
    {
      "name": "a newer stop never replaces a displayed attention",
      "steps": [
        {
          "push": {
            "type": "attention",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_precedence_00a",
            "seq": [
              1,
              1
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "push": {
            "type": "activity_stop",
            "instanceId": "aaaa1111bbbb2222",
            "seq": [
              1,
              2
            ],
            "badge": [
              1,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-aaaa1111bbbb2222|attention|req_precedence_00a"
        ],
        "badge": [
          1,
          true
        ],
        "alerts": 1
      }
    },
    {
      "name": "a fleet device renders Push v2 local alerts but ignores their counts, and tombstones still apply",
      "fleet": true,
      "steps": [
        {
          "push": {
            "type": "attention",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_legacy_00000a",
            "seq": [
              3,
              1
            ],
            "badge": [
              3,
              false
            ]
          }
        },
        {
          "legacy": {
            "type": "clear",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_legacy_00000a",
            "pendingAskCount": 0
          }
        },
        {
          "legacy": {
            "type": "attention",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_legacy_00000a",
            "pendingAskCount": 1
          }
        },
        {
          "legacy": {
            "type": "attention",
            "instanceId": "cccc3333dddd4444",
            "requestId": "req_legacy_00000b",
            "pendingAskCount": 7
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-cccc3333dddd4444|attention|req_legacy_00000b"
        ],
        "badge": [
          3,
          false
        ],
        "alerts": 2
      }
    },
    {
      "name": "foreground reconciliation closes resolved asks of fresh sources only and pins the badge against older pushes",
      "steps": [
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_reconcile_00a",
            "seq": [
              2,
              1
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "laptop",
            "instanceId": "cccc3333dddd4444",
            "requestId": "req_reconcile_00b",
            "seq": [
              2,
              3
            ],
            "badge": [
              2,
              true
            ]
          }
        },
        {
          "reconcile": {
            "fresh": [
              "local",
              "studio"
            ],
            "pending": [],
            "badge": [
              1,
              false
            ]
          }
        },
        {
          "push": {
            "type": "attention",
            "source": "studio",
            "instanceId": "eeee5555ffff6666",
            "requestId": "req_reconcile_00c",
            "seq": [
              2,
              2
            ],
            "badge": [
              5,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-Zm7JF6omGejLZ9M1ygWBi2-cccc3333dddd4444|attention|req_reconcile_00b",
          "omp-attention-xeffoL_kxqTcht3AiIR0FT-eeee5555ffff6666|attention|req_reconcile_00c"
        ],
        "badge": [
          1,
          false
        ],
        "alerts": 3
      }
    },
    {
      "name": "tombstones age out only after the retention window",
      "steps": [
        {
          "push": {
            "type": "clear",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_retention_00a",
            "seq": [
              1,
              2
            ],
            "badge": [
              0,
              true
            ]
          }
        },
        {
          "advance": 1799000
        },
        {
          "push": {
            "type": "attention",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_retention_00a",
            "seq": [
              2,
              1
            ],
            "badge": [
              1,
              true
            ]
          }
        },
        {
          "advance": 2000
        },
        {
          "push": {
            "type": "attention",
            "instanceId": "aaaa1111bbbb2222",
            "requestId": "req_retention_00a",
            "seq": [
              2,
              2
            ],
            "badge": [
              1,
              true
            ]
          }
        }
      ],
      "expect": {
        "displayed": [
          "omp-attention-aaaa1111bbbb2222|attention|req_retention_00a"
        ],
        "badge": [
          1,
          true
        ],
        "alerts": 1
      }
    }
  ]
}
