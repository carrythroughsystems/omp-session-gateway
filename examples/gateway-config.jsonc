{
  "http": {
    "hostname": "127.0.0.1",
    "port": 4317,
    "publicOrigin": "https://host.example.ts.net",
    // Opt-in: exact dashboard origins allowed to list and launch on this host,
    // and to create approved processes if the tern section below is enabled.
    // The target must separately allow the user's Tailscale login below.
    "trustedDashboardOrigins": []
  },
  "auth": {
    "mode": "tailscale-serve",
    "allowedLogins": ["replace-with-your-tailnet-login@example.com"]
  },
  "registry": {
    "heartbeatSeconds": 10,
    "ttlSeconds": 35,
    "maxSessions": 100
  },
  "fleet": {
    // Optional; defaults to the public origin's first DNS label.
    "label": "host",
    // Dashboard-side opt-in; at most seven explicitly configured gateway origins.
    // Each target must trust this dashboard's publicOrigin. Reload the PWA after edits.
    "targets": []
  },
  "speech": {
    // Keyboard dictation remains available without this optional browser recognizer.
    "browserRecognition": false
  }
  // Optional Tern creation is absent by default. To opt in on this execution host,
  // add a comma after speech, uncomment the block below, strip // comments when writing
  // strict JSON to <configDir>/config.json, replace the synthetic paths, and re-run
  // omp-gateway install --origin <origin> --allow <login>. Working-copy paths must equal
  // their realpath; profile.env is the complete CLI child environment (not merged with
  // process.env) and requires absolute HOME and PATH. Configure OMP inside Tern with
  // collab.autoStart=control first. The CLI opens the tab in Tern's first window.
  // See docs/OPERATIONS.md#opt-in-tern-session-creation.
  // "tern": {
  //   "executable": "/usr/local/bin/tern",
  //   "projects": [
  //     {
  //       "id": "alpha-founder",
  //       "label": "Alpha Founder",
  //       "workingCopies": [
  //         {
  //           "id": "main",
  //           "label": "main",
  //           "path": "/home/user/Development/alpha-founder"
  //         }
  //       ]
  //     }
  //   ],
  //   "profiles": [
  //     {
  //       "id": "omp",
  //       "label": "OMP",
  //       "argv": ["/opt/homebrew/bin/omp"],
  //       "env": {
  //         "HOME": "/home/user",
  //         "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
  //       }
  //     }
  //   ]
  // }
}
